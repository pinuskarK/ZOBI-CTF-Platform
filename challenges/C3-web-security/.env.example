# Copy this file to .env and replace every placeholder with private values.
# Never commit .env or expose it in screenshots.
C3_FLAG=REPLACE_WITH_THE_FLAG_CONFIGURED_IN_CTFD
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
C3_DEMO_USERNAME=researcher
C3_DEMO_PASSWORD=REPLACE_WITH_A_PRIVATE_LAB_PASSWORD
# Default loopback binding. Set to the approved lab interface IP only when needed.
C3_BIND_ADDRESS=127.0.0.1
