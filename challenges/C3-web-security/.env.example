# Copy to .env and replace both values with private, random values.
# Never commit .env or share its contents in screenshots.
C3_FLAG=REPLACE_WITH_THE_FLAG_CONFIGURED_IN_CTFD
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Default is loopback only. Set to the authorised lab interface IP if remote
# participants must access C3, and enforce the matching host firewall rule.
C3_BIND_ADDRESS=127.0.0.1
